{
  "name": "benchmaster-frontend",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.23.5"
  },
  "scripts": {
    "check:node": "node ../scripts/check-node.mjs",
    "ng": "npm run check:node && ng",
    "prestart": "npm run check:node && node scripts/write-env.mjs",
    "start": "ng serve --host 0.0.0.0",
    "prebuild": "npm run check:node && node scripts/write-env.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run check:node",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@playwright/test": "^1.65.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "^6.0.3"
  }
}
