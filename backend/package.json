{
  "name": "benchmaster-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "prisma:generate": "npm run prisma7:generate",
    "prisma7:generate": "prisma7 generate --config prisma7.config.ts",
    "prisma7:migrate": "prisma7 migrate dev --name init --config prisma7.config.ts",
    "prisma8:emit": "prisma contract emit",
    "db:setup": "prisma7 migrate deploy --config prisma7.config.ts && npm run db:seed",
    "db:seed": "tsx prisma/seed.ts",
    "db:bootstrap": "tsx prisma/bootstrap.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/orm-postgres": "8.0.0-rc.18",
    "@prisma/prisma7": "^7.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "temporal-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.14",
    "tsx": "^4.19.3",
    "typescript": "^5.9.2"
  }
}
