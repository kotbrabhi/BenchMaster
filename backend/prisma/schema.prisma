generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameStatus {
  DRAFT
  LIVE
  PAUSED
  FINISHED
}

enum PeriodStatus {
  NOT_STARTED
  LIVE
  COMPLETED
}

enum RotationEventType {
  PERIOD_START
  SUBSTITUTION
  PERIOD_END
  GAME_END
}

enum TeamGender {
  MIXED
  FEMININE
  MASCULINE
}

model Team {
  id        Int      @id @default(autoincrement())
  userId    Int?
  name      String
  gender    TeamGender @default(MIXED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  players   Player[]
  games     Game[]

  @@index([userId])
}

model Player {
  id           Int        @id @default(autoincrement())
  teamId       Int
  name         String
  jerseyNumber String
  position     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  gamePlayers  GamePlayer[]

  @@unique([teamId, jerseyNumber])
}

model Game {
  id                  Int          @id @default(autoincrement())
  teamId              Int
  label               String
  status              GameStatus   @default(DRAFT)
  currentPeriodNumber Int          @default(1)
  currentPeriodStatus PeriodStatus @default(NOT_STARTED)
  startedAt           DateTime?
  endedAt             DateTime?
  isClockRunning      Boolean      @default(false)
  clockElapsedSeconds Int          @default(0)
  lastClockStartedAt  DateTime?
  periodElapsedSeconds Int         @default(0)
  lastPeriodStartedAt DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  team                Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  players             GamePlayer[]
  rotationEvents      GameRotationEvent[]

  /// TODO(axis-2): Add per-possession and per-segment stat rollups here once player statistics are introduced.

  @@index([teamId])
}

model User {
  id           Int      @id @default(autoincrement())
  name         String?
  email        String   @unique
  passwordHash String
  passwordSalt String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  teams        Team[]
}

model GamePlayer {
  id          Int             @id @default(autoincrement())
  gameId       Int
  playerId     Int
  isAvailable  Boolean        @default(true)
  isStarter    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  game         Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player       Player         @relation(fields: [playerId], references: [id], onDelete: Restrict)
  playingTime  PlayerGameTime?

  @@unique([gameId, playerId])
}

model PlayerGameTime {
  id            Int        @id @default(autoincrement())
  gamePlayerId  Int        @unique
  totalSeconds  Int        @default(0)
  periodSeconds Int        @default(0)
  points        Int        @default(0)
  assists       Int        @default(0)
  blocks        Int        @default(0)
  rebounds      Int        @default(0)
  isOnCourt     Boolean    @default(false)
  lastEnteredAt DateTime?
  lastPeriodEnteredAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  gamePlayer    GamePlayer @relation(fields: [gamePlayerId], references: [id], onDelete: Cascade)

  /// TODO(axis-2): Link stats events to on-court time segments so advanced metrics can be calculated accurately.
}

model GameRotationEvent {
  id               Int               @id @default(autoincrement())
  gameId           Int
  kind             RotationEventType
  periodNumber     Int
  clockMarkSeconds Int               @default(0)
  payload          Json?
  createdAt        DateTime          @default(now())
  game             Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, periodNumber, clockMarkSeconds, id])
}
