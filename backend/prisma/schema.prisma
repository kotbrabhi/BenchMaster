generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GameStatus {
  DRAFT
  LIVE
  PAUSED
  FINISHED
}

enum PeriodStatus {
  NOT_STARTED
  LIVE
  COMPLETED
}

enum RotationEventType {
  PERIOD_START
  SUBSTITUTION
  PERIOD_END
  GAME_END
}

enum TeamGender {
  MIXED
  FEMININE
  MASCULINE
}

enum FriendlyProposalStatus {
  DRAFT
  OPEN
  IN_DISCUSSION
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum FriendlyApplicationStatus {
  INTERESTED
  COLLECTING
  SUBMITTED
  NEEDS_RECONFIRMATION
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum FriendlyAvailability {
  AVAILABLE
  UNAVAILABLE
}

enum FriendlyMatchLifecycle {
  CONFIRMED
  CANCELLED
}

enum FriendlyNotificationType {
  INTEREST_RECEIVED
  TEAM_SUBMITTED
  MATCH_CONFIRMED
  APPLICATION_REJECTED
  MATCH_CANCELLED
}

model Team {
  id        Int      @id @default(autoincrement())
  userId    Int?
  name      String
  gender    TeamGender @default(MIXED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  players   Player[]
  games     Game[]
  friendlyProposals FriendlyMatchProposal[]
  friendlyApplications FriendlyMatchApplication[]
  organizerFriendlyMatches FriendlyConfirmedMatch[] @relation("OrganizerFriendlyMatches")
  candidateFriendlyMatches FriendlyConfirmedMatch[] @relation("CandidateFriendlyMatches")

  @@index([userId])
}

model FriendlyMatchProposal {
  id                   Int                    @id @default(autoincrement())
  organizerTeamId      Int
  createdByUserId      Int
  status               FriendlyProposalStatus @default(OPEN)
  category             String
  startsAt             DateTime               @db.Timestamptz(3)
  durationMinutes      Int?
  area                 String
  venueName            String?
  format               String
  requestedPlayerCount Int?
  level                String?
  notes                String?
  responseDeadline     DateTime?              @db.Timestamptz(3)
  createdAt            DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(3)
  cancelledAt          DateTime?              @db.Timestamptz(3)
  organizerTeam        Team                   @relation(fields: [organizerTeamId], references: [id], onDelete: Restrict)
  createdBy            User                   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  applications         FriendlyMatchApplication[]
  confirmation         FriendlyConfirmedMatch?
  notifications        FriendlyNotification[]

  @@index([status, startsAt])
  @@index([organizerTeamId, createdAt])
}

model Player {
  id           Int        @id @default(autoincrement())
  teamId       Int
  name         String
  jerseyNumber String
  position     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  gamePlayers  GamePlayer[]
  friendlyResponses FriendlyPlayerResponse[]
  friendlyApplications FriendlyApplicationPlayer[]

  @@unique([teamId, jerseyNumber])
}

model FriendlyMatchApplication {
  id          Int                        @id @default(autoincrement())
  proposalId  Int
  teamId      Int
  coachUserId Int
  status      FriendlyApplicationStatus @default(INTERESTED)
  submittedAt DateTime?                 @db.Timestamptz(3)
  acceptedAt  DateTime?                 @db.Timestamptz(3)
  createdAt   DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                   @updatedAt @db.Timestamptz(3)
  proposal    FriendlyMatchProposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  team        Team                       @relation(fields: [teamId], references: [id], onDelete: Restrict)
  coach       User                       @relation(fields: [coachUserId], references: [id], onDelete: Restrict)
  playerResponses FriendlyPlayerResponse[]
  proposedPlayers FriendlyApplicationPlayer[]
  teamInvite     FriendlyInvite?             @relation("ApplicationInvite")
  confirmation FriendlyConfirmedMatch?
  notifications FriendlyNotification[]

  @@unique([proposalId, teamId])
  @@index([coachUserId, status])
  @@index([proposalId, status])
}

model FriendlyPlayerResponse {
  id                   Int                  @id @default(autoincrement())
  applicationId        Int
  playerId             Int?
  playerNameSnapshot   String
  jerseyNumberSnapshot String
  availability         FriendlyAvailability?
  respondedAt          DateTime?             @db.Timestamptz(3)
  revision             Int                   @default(0)
  normalizedName       String                @default("")
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  application          FriendlyMatchApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  player               Player?               @relation(fields: [playerId], references: [id], onDelete: SetNull)
  invite               FriendlyInvite?       @relation("ResponseInvite")
  availabilityHistory FriendlyPlayerAvailabilityHistory[]

  @@unique([applicationId, playerId])
  @@unique([applicationId, normalizedName])
  @@index([applicationId, availability])
}

model FriendlyPlayerAvailabilityHistory {
  id           Int                  @id @default(autoincrement())
  responseId   Int
  availability FriendlyAvailability
  respondedAt  DateTime?            @db.Timestamptz(3)
  changedAt    DateTime             @default(now()) @db.Timestamptz(3)
  response     FriendlyPlayerResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId, changedAt])
}

model FriendlyApplicationPlayer {
  id                   Int                     @id @default(autoincrement())
  applicationId        Int
  playerId             Int?
  playerNameSnapshot   String
  jerseyNumberSnapshot String
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  application          FriendlyMatchApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  player               Player?                 @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([applicationId, playerId])
  @@index([applicationId])
}

model FriendlyInvite {
  id         Int                   @id @default(autoincrement())
  responseId Int?                  @unique
  applicationId Int?               @unique
  tokenHash  String                @unique
  expiresAt  DateTime              @db.Timestamptz(3)
  revokedAt  DateTime?             @db.Timestamptz(3)
  lastUsedAt DateTime?             @db.Timestamptz(3)
  createdAt  DateTime              @default(now()) @db.Timestamptz(3)
  response   FriendlyPlayerResponse? @relation("ResponseInvite", fields: [responseId], references: [id], onDelete: Cascade)
  application FriendlyMatchApplication? @relation("ApplicationInvite", fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([expiresAt, revokedAt])
}

model FriendlyConfirmedMatch {
  id                    Int                     @id @default(autoincrement())
  proposalId            Int                     @unique
  applicationId         Int                     @unique
  organizerTeamId       Int
  candidateTeamId       Int
  startsAt              DateTime                @db.Timestamptz(3)
  durationMinutes       Int?
  area                  String
  format                String
  status                FriendlyMatchLifecycle @default(CONFIRMED)
  confirmedAt           DateTime                @default(now()) @db.Timestamptz(3)
  cancelledAt           DateTime?               @db.Timestamptz(3)
  cancelledByUserId     Int?
  cancellationReason    String?
  proposal              FriendlyMatchProposal   @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  application           FriendlyMatchApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  organizerTeam         Team                    @relation("OrganizerFriendlyMatches", fields: [organizerTeamId], references: [id], onDelete: Restrict)
  candidateTeam         Team                    @relation("CandidateFriendlyMatches", fields: [candidateTeamId], references: [id], onDelete: Restrict)

  @@index([organizerTeamId, startsAt])
  @@index([candidateTeamId, startsAt])
  @@index([status, startsAt])
}

model FriendlyNotification {
  id            Int                      @id @default(autoincrement())
  userId        Int
  type          FriendlyNotificationType
  proposalId    Int?
  applicationId Int?
  createdAt     DateTime                 @default(now()) @db.Timestamptz(3)
  readAt        DateTime?                @db.Timestamptz(3)
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposal      FriendlyMatchProposal?   @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  application   FriendlyMatchApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
}

model Game {
  id                  Int          @id @default(autoincrement())
  teamId              Int
  label               String
  shareToken          String?      @unique
  status              GameStatus   @default(DRAFT)
  currentPeriodNumber Int          @default(1)
  currentPeriodStatus PeriodStatus @default(NOT_STARTED)
  startedAt           DateTime?
  endedAt             DateTime?
  isClockRunning      Boolean      @default(false)
  clockElapsedSeconds Int          @default(0)
  lastClockStartedAt  DateTime?
  periodElapsedSeconds Int         @default(0)
  lastPeriodStartedAt DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  team                Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  players             GamePlayer[]
  rotationEvents      GameRotationEvent[]

  /// TODO(axis-2): Add per-possession and per-segment stat rollups here once player statistics are introduced.

  @@index([teamId])
}

model User {
  id           Int      @id @default(autoincrement())
  name         String?
  email        String   @unique
  passwordHash String
  passwordSalt String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  teams        Team[]
  friendlyProposals FriendlyMatchProposal[]
  friendlyApplications FriendlyMatchApplication[]
  friendlyNotifications FriendlyNotification[]
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GamePlayer {
  id          Int             @id @default(autoincrement())
  gameId       Int
  playerId     Int
  isAvailable  Boolean        @default(true)
  isStarter    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  game         Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player       Player         @relation(fields: [playerId], references: [id], onDelete: Restrict)
  playingTime  PlayerGameTime?

  @@unique([gameId, playerId])
}

model PlayerGameTime {
  id            Int        @id @default(autoincrement())
  gamePlayerId  Int        @unique
  totalSeconds  Int        @default(0)
  periodSeconds Int        @default(0)
  points        Int        @default(0)
  assists       Int        @default(0)
  blocks        Int        @default(0)
  rebounds      Int        @default(0)
  interceptions Int        @default(0)
  fouls         Int        @default(0)
  periodFouls   Int        @default(0)
  isOnCourt     Boolean    @default(false)
  lastEnteredAt DateTime?
  lastPeriodEnteredAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  gamePlayer    GamePlayer @relation(fields: [gamePlayerId], references: [id], onDelete: Cascade)

  /// TODO(axis-2): Link stats events to on-court time segments so advanced metrics can be calculated accurately.
}

model GameRotationEvent {
  id               Int               @id @default(autoincrement())
  gameId           Int
  kind             RotationEventType
  periodNumber     Int
  clockMarkSeconds Int               @default(0)
  payload          Json?
  createdAt        DateTime          @default(now())
  game             Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, periodNumber, clockMarkSeconds, id])
}

model SharedGameSnapshot {
  id        Int      @id @default(autoincrement())
  shareId   String   @unique
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
